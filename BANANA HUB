<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Quoc Anh Hub - Get Key</title>

<style>
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-family: Arial, sans-serif;
}

body {
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    background:
        radial-gradient(circle at top, #2b2100 0%, #111 35%, #050505 75%);
    color: white;
    overflow: hidden;
}

body::before {
    content: "";
    position: fixed;
    width: 350px;
    height: 350px;
    background: #ffd21c;
    filter: blur(150px);
    opacity: .12;
    top: -100px;
    left: -100px;
}

body::after {
    content: "";
    position: fixed;
    width: 300px;
    height: 300px;
    background: #ffb800;
    filter: blur(150px);
    opacity: .10;
    bottom: -100px;
    right: -100px;
}

.container {
    width: min(92%, 430px);
    position: relative;
    z-index: 2;
}

.card {
    padding: 32px 25px;
    border: 1px solid rgba(255, 210, 28, .35);
    border-radius: 24px;
    background: rgba(15, 15, 15, .88);
    backdrop-filter: blur(18px);
    box-shadow:
        0 0 30px rgba(255, 210, 28, .10),
        inset 0 0 30px rgba(255, 255, 255, .02);
    text-align: center;
}

.logo {
    width: 76px;
    height: 76px;
    margin: 0 auto 15px;
    border-radius: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 35px;
    font-weight: 900;
    color: #111;
    background: linear-gradient(135deg, #ffe45c, #ffb700);
    box-shadow:
        0 0 20px rgba(255, 210, 28, .45),
        0 0 50px rgba(255, 210, 28, .18);
}

h1 {
    font-size: 27px;
    margin-bottom: 8px;
}

.highlight {
    color: #ffd21c;
}

.subtitle {
    color: #999;
    font-size: 14px;
    line-height: 1.5;
    margin-bottom: 25px;
}

.status {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    color: #aaa;
    font-size: 12px;
    margin-bottom: 20px;
}

.dot {
    width: 8px;
    height: 8px;
    background: #55ff88;
    border-radius: 50%;
    box-shadow: 0 0 10px #55ff88;
}

button {
    width: 100%;
    border: none;
    cursor: pointer;
    border-radius: 13px;
    padding: 15px;
    font-size: 15px;
    font-weight: 800;
    transition: .2s ease;
}

.get-btn {
    color: #111;
    background: linear-gradient(135deg, #ffe45c, #ffb700);
    box-shadow: 0 8px 25px rgba(255, 194, 0, .20);
}

.get-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 35px rgba(255, 194, 0, .35);
}

.get-btn:active {
    transform: scale(.98);
}

.key-box {
    display: none;
    margin-top: 18px;
    animation: appear .3s ease;
}

.key-display {
    padding: 14px;
    border-radius: 12px;
    background: #090909;
    border: 1px solid #292929;
    color: #ffd21c;
    font-size: 14px;
    word-break: break-all;
    margin-bottom: 10px;
}

.copy-btn {
    color: white;
    background: #1c1c1c;
    border: 1px solid #333;
}

.copy-btn:hover {
    background: #242424;
}

.info {
    margin-top: 22px;
    padding-top: 18px;
    border-top: 1px solid #252525;
    color: #777;
    font-size: 11px;
    line-height: 1.6;
}

.toast {
    position: fixed;
    left: 50%;
    bottom: 25px;
    transform: translate(-50%, 20px);
    opacity: 0;
    pointer-events: none;
    padding: 12px 18px;
    border-radius: 10px;
    background: #181818;
    border: 1px solid #333;
    color: white;
    font-size: 13px;
    transition: .3s;
    z-index: 10;
}

.toast.show {
    opacity: 1;
    transform: translate(-50%, 0);
}

@keyframes appear {
    from {
        opacity: 0;
        transform: translateY(8px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@media (max-width: 420px) {
    .card {
        padding: 27px 20px;
    }

    h1 {
        font-size: 24px;
    }
}
</style>
</head>

<body>

<div class="container">
    <div class="card">

        <div class="logo">QA</div>

        <h1>
            <span class="highlight">QUOC ANH</span> HUB
        </h1>

        <p class="subtitle">
            Get your key to access the menu.
            Click the button below to receive your key.
        </p>

        <div class="status">
            <span class="dot"></span>
            Key System Online
        </div>

        <button class="get-btn" onclick="getKey()">
            🔑 GET KEY
        </button>

        <div class="key-box" id="keyBox">

            <div class="key-display" id="keyDisplay">
                Your key will appear here
            </div>

            <button class="copy-btn" onclick="copyKey()">
                📋 COPY KEY
            </button>

        </div>

        <div class="info">
            Key được dùng để mở khóa menu của bạn.<br>
            Không chia sẻ key nếu bạn muốn giới hạn quyền sử dụng.
        </div>

    </div>
</div>

<div class="toast" id="toast">
    Đã copy key!
</div>

<script>

/*
    DEMO KEY
    Thay key này bằng key của bạn.

    Lưu ý:
    Đây chỉ là frontend demo.
    Không đặt key bí mật thật trong GitHub Pages.
*/

const MY_KEY = "QUOCANH-2026-KEY";

function getKey() {

    const box = document.getElementById("keyBox");
    const display = document.getElementById("keyDisplay");

    display.textContent = MY_KEY;
    box.style.display = "block";

    showToast("Đã lấy key thành công!");
}

function copyKey() {

    const key = document.getElementById("keyDisplay").textContent;

    navigator.clipboard.writeText(key)
        .then(() => {
            showToast("Đã copy key!");
        })
        .catch(() => {
            showToast("Không thể copy tự động!");
        });
}

function showToast(message) {

    const toast = document.getElementById("toast");

    toast.textContent = message;
    toast.classList.add("show");

    setTimeout(() => {
        toast.classList.remove("show");
    }, 1800);
}

</script>

</body>
</html>
