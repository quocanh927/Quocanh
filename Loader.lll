Instance.new("UICorner",Notice).CornerRadius = UDim.new(0,12)

local NoticeStroke = Instance.new("UIStroke",Notice)
NoticeStroke.Color = Color.Line
NoticeStroke.Thickness = 1

local NoticeText = Instance.new("TextLabel")
