task.spawn(function()
	while Gui.Parent do
		Shine.Position = UDim2.fromOffset(-70,-18)

		local tween = TweenService:Create(
			Shine,
			TweenInfo.new(1.35,Enum.EasingStyle.Quad,Enum.EasingDirection.InOut),
			{Position=UDim2.fromOffset(315,-18)}
		)

		tween:Play()
		tween.Completed:Wait()
		task.wait(1)
	end
end)

