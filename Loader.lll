local ScriptLayout = Instance.new("UIListLayout")
ScriptLayout.Padding = UDim.new(0,7)
ScriptLayout.SortOrder = Enum.SortOrder.LayoutOrder
ScriptLayout.Parent = ScriptScroll

local CurrentCategory = "Home"

local function ClearScripts()
	for _,v in ipairs(ScriptScroll:GetChildren()) do
		if v:IsA("Frame") or v:IsA("TextLabel") then
			v:Destroy()
		end
	end
end

local function RunScript(code)
	task.spawn(function()
		local ok,err = pcall(function()
			loadstring(code)()
		end)

		if not ok then
			warn("QuocAnhMenu Script Error:",err)
		end
	end)
end

local function AddScript(scriptName,code,index)
	local Card = Instance.new("Frame")
	Card.Size = UDim2.new(1,0,0,48)
	Card.BackgroundColor3 = Color.Card
	Card.BackgroundTransparency = .06
	Card.BorderSizePixel = 0
	Card.LayoutOrder = index
	Card.ZIndex = 13
	Card.Parent = ScriptScroll

	Instance.new("UICorner",Card).CornerRadius = UDim.new(0,12)

	local Stroke = Instance.new("UIStroke",Card)
	Stroke.Color = Color.Line
	Stroke.Thickness = 1

	-- RUN BUTTON
	local Run = Instance.new("TextButton")
	Run.Size = UDim2.fromOffset(48,30)
	Run.Position = UDim2.new(0,8,.5,-15)
	Run.BackgroundColor3 = Color.Dark
	Run.BackgroundTransparency = .05
	Run.BorderSizePixel = 0
	Run.Text = "RUN"
	Run.TextColor3 = Color.White
	Run.TextSize = 9
	Run.Font = Enum.Font.GothamBold
	Run.ZIndex = 15
	Run.Parent = Card

	Instance.new("UICorner",Run).CornerRadius = UDim.new(0,8)

	local RunStroke = Instance.new("UIStroke",Run)
	RunStroke.Color = Color.Line
	RunStroke.Thickness = 1

	-- SCRIPT NAME
	local Name = Instance.new("TextLabel")
	Name.Size = UDim2.new(1,-105,1,0)
	Name.Position = UDim2.fromOffset(65,0)
	Name.BackgroundTransparency = 1
	Name.Text = scriptName
	Name.TextColor3 = Color.White
	Name.TextSize = 10
	Name.Font = Enum.Font.GothamMedium
	Name.TextXAlignment = Enum.TextXAlignment.Left
	Name.TextTruncate = Enum.TextTruncate.AtEnd
	Name.ZIndex = 14
	Name.Parent = Card

	-- INITIAL CIRCLE
	local Initial = string.upper(string.sub(scriptName,1,1))

	local Circle = Instance.new("TextLabel")
	Circle.Size = UDim2.fromOffset(28,28)
	Circle.Position = UDim2.new(1,-37,.5,-14)
	Circle.BackgroundColor3 = Color.Dark
	Circle.BackgroundTransparency = .02
	Circle.BorderSizePixel = 0
	Circle.Text = Initial
	Circle.TextColor3 = Color.White
	Circle.TextSize = 10
	Circle.Font = Enum.Font.GothamBold
	Circle.ZIndex = 15
	Circle.Parent = Card

	Instance.new("UICorner",Circle).CornerRadius = UDim.new(1,0)

	local CircleStroke = Instance.new("UIStroke",Circle)
	CircleStroke.Color = Color.Line
	CircleStroke.Thickness = 1

	Run.MouseButton1Click:Connect(function()
		RunScript(code)

		TweenService:Create(
			Run,
			TweenInfo.new(.1),
			{BackgroundColor3=Color.Green}
		):Play()

		task.delay(.25,function()
			if Run.Parent then
				TweenService:Create(
					Run,
					TweenInfo.new(.2),
					{BackgroundColor3=Color.Dark}
				):Play()
			end
		end)
	end)

	Card.MouseEnter:Connect(function()
		TweenService:Create(
			Card,
			TweenInfo.new(.15),
			{BackgroundColor3=Color.CardHover}
		):Play()

		TweenService:Create(
			Circle,
			TweenInfo.new(.15),
			{BackgroundColor3=Color.CardHover}
		):Play()
	end)

	Card.MouseLeave:Connect(function()
		TweenService:Create(
			Card,
			TweenInfo.new(.15),
			{BackgroundColor3=Color.Card}
		):Play()

		TweenService:Create(
			Circle,
			TweenInfo.new(.15),
			{BackgroundColor3=Color.Dark}
		):Play()
	end)
end
--// QUOC ANH MENU - PART 3/3

local Buttons = {}

local function MakeSideButton(textValue,icon,order)
	local Button = Instance.new("TextButton")
	Button.Size = UDim2.new(1,0,0,42)
	Button.BackgroundColor3 = Color.Card
	Button.BackgroundTransparency = .35
	Button.BorderSizePixel = 0
	Button.Text = ""
	Button.LayoutOrder = order
	Button.ZIndex = 14
	Button.Parent = SideList

	Instance.new("UICorner",Button).CornerRadius = UDim.new(0,10)

	local Stroke = Instance.new("UIStroke",Button)
	Stroke.Color = Color.Line
	Stroke.Thickness = 1

	local Icon = Instance.new("TextLabel")
	Icon.Size = UDim2.fromOffset(30,42)
	Icon.BackgroundTransparency = 1
	Icon.Text = icon
	Icon.TextSize = 15
	Icon.ZIndex = 15
	Icon.Parent = Button

	local Name = Instance.new("TextLabel")
	Name.Size = UDim2.new(1,-36,1,0)
	Name.Position = UDim2.fromOffset(35,0)
	Name.BackgroundTransparency = 1
	Name.Text = textValue
	Name.TextColor3 = Color.Gray
	Name.TextSize = 9
	Name.Font = Enum.Font.GothamMedium
	Name.TextXAlignment = Enum.TextXAlignment.Left
	Name.ZIndex = 15
	Name.Parent = Button

	Buttons[textValue] = Button

	Button.MouseEnter:Connect(function()
		TweenService:Create(
			Button,
			TweenInfo.new(.12),
			{BackgroundColor3=Color.CardHover,BackgroundTransparency=.05}
		):Play()
	end)

	Button.MouseLeave:Connect(function()
		if CurrentCategory ~= textValue then
			TweenService:Create(
				Button,
				TweenInfo.new(.12),
				{BackgroundColor3=Color.Card,BackgroundTransparency=.35}
			):Play()
		end
	end)

	Button.MouseButton1Click:Connect(function()
		ShowPage(textValue)
	end)

	return Button
end

function ShowPage(category)
	CurrentCategory = category

	for name,button in pairs(Buttons) do
		if name == category then
			TweenService:Create(
				button,
				TweenInfo.new(.15),
				{BackgroundColor3=Color.CardHover,BackgroundTransparency=.02}
			):Play()

			local stroke = button:FindFirstChildOfClass("UIStroke")
			if stroke then
				stroke.Color = Color.Blue
			end
		else
			TweenService:Create(
				button,
				TweenInfo.new(.15),
				{BackgroundColor3=Color.Card,BackgroundTransparency=.35}
			):Play()

			local stroke = button:FindFirstChildOfClass("UIStroke")
			if stroke then
				stroke.Color = Color.Line
			end
		end
	end

	if category == "Home" then
		PageTitle.Text = "Home"
		PageSub.Text = "Welcome back, Owner"

		Home.Visible = true
		ScriptScroll.Visible = false
	else
		PageTitle.Text = category
		PageSub.Text = "Available scripts • QuocAnhMenu"

		Home.Visible = false
		ScriptScroll.Visible = true

		ClearScripts()

		local list = Scripts[category]
		if list then
			for i,data in ipairs(list) do
				AddScript(data[1],data[2],i)
			end
		end

		ScriptScroll.CanvasPosition = Vector2.new(0,0)
	end
end

--// HOME FIRST, ALWAYS
MakeSideButton("Home","⌂",1)
MakeSideButton("Steal a Egg","🥚",2)
MakeSideButton("Blox Fruit","🍎",3)
MakeSideButton("Blade Ball","⚔️",4)

ShowPage("Home")

--// SEARCH
Search:GetPropertyChangedSignal("Text"):Connect(function()
	local query = string.lower(Search.Text)

	if CurrentCategory == "Home" then
		return
	end

	for _,card in ipairs(ScriptScroll:GetChildren()) do
		if card:IsA("Frame") then
			local nameLabel = card:FindFirstChildOfClass("TextLabel")

			if nameLabel then
				local found = query == ""
					or string.find(string.lower(nameLabel.Text),query,1,true)

				card.Visible = found
			end
		end
	end
end)

