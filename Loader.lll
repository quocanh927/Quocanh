local NoticeClose = Instance.new("TextButton")
NoticeClose.Size = UDim2.fromOffset(25,25)
NoticeClose.Position = UDim2.new(1,-31,.5,-12)
NoticeClose.BackgroundColor3 = Color.Dark
NoticeClose.BackgroundTransparency = .05
NoticeClose.BorderSizePixel = 0
NoticeClose.Text = "×"
NoticeClose.TextColor3 = Color.Gray
NoticeClose.TextSize = 16
NoticeClose.Font = Enum.Font.GothamBold
NoticeClose.ZIndex = 202
NoticeClose.Parent = Notice

Instance.new("UICorner",NoticeClose).CornerRadius = UDim.new(1,0)

local NoticeClosed = false

NoticeClose.MouseButton1Click:Connect(function()
	NoticeClosed = true

	TweenService:Create(
		Notice,
		TweenInfo.new(.18,Enum.EasingStyle.Quad,Enum.EasingDirection.In),
		{Position=UDim2.new(.5,-160,1,70)}
	):Play()
end)

--// NOTIFICATION ANIMATION
task.spawn(function()
	task.wait(.7)

	if NoticeClosed then
		return
	end

	TweenService:Create(
		Notice,
		TweenInfo.new(.35,Enum.EasingStyle.Quint,Enum.EasingDirection.Out),
		{Position=UDim2.new(.5,-160,1,-72)}
	):Play()

	task.wait(7)

	if not NoticeClosed then
		TweenService:Create(
			Notice,
			TweenInfo.new(.3,Enum.EasingStyle.Quad,Enum.EasingDirection.In),
			{Position=UDim2.new(.5,-160,1,70)}
		):Play()
	end
end)

--// TITLE PILL SOFT GLOW
task.spawn(function()
	while Gui.Parent do
		TweenService:Create(
			PillStroke,
			TweenInfo.new(1.2,Enum.EasingStyle.Sine,Enum.EasingDirection.InOut),
			{Thickness=1.5}
		):Play()

		task.wait(1.2)

		TweenService:Create(
			PillStroke,
			TweenInfo.new(1.2,Enum.EasingStyle.Sine,Enum.EasingDirection.InOut),
			{Thickness=1}
		):Play()

		task.wait(1.2)
	end
end)

