Grid:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
    ScriptScroll.CanvasSize = UDim2.fromOffset(
        0,
        Grid.AbsoluteContentSize.Y + 12
    )
end)

local Current = "Home"

local function ClearScripts()
    for _,v in ipairs(ScriptScroll:GetChildren()) do
        if v:IsA("TextButton") or v.Name == "Empty" then
            v:Destroy()
        end
    end
end

local function Run(code)
    task.spawn(function()
        local fn,err = loadstring(code)
        if fn then
            local ok,e = pcall(fn)
            if not ok then
                warn("[QuocAnhMenu]",e)
            end
        else
            warn("[QuocAnhMenu]",err)
        end
    end)
end

local function AddScript(name,code,index)
    local Button = Instance.new("TextButton")
    Button.Name = "Script_"..index
    Button.Text = ""
    Button.AutoButtonColor = false
    Button.BackgroundColor3 = Color.Card
    Button.BackgroundTransparency = .02
    Button.BorderSizePixel = 0
    Button.LayoutOrder = index
    Button.ZIndex = 14
    Button.Parent = ScriptScroll

    Instance.new("UICorner",Button).CornerRadius = UDim.new(0,10)

    local Stroke = Instance.new("UIStroke",Button)
    Stroke.Color = Color.Line
    Stroke.Thickness = 1

    local Play = Instance.new("TextLabel")
    Play.Size = UDim2.fromOffset(30,30)
    Play.Position = UDim2.fromOffset(8,11)
    Play.BackgroundColor3 = Color.Panel
    Play.BackgroundTransparency = .1
    Play.BorderSizePixel = 0
    Play.Text = "▶"
    Play.TextColor3 = Color.White
    Play.TextSize = 10
    Play.Font = Enum.Font.GothamBold
    Play.ZIndex = 16
    Play.Parent = Button

    Instance.new("UICorner",Play).CornerRadius = UDim.new(0,8)

    local Text = Instance.new("TextLabel")
    Text.Size = UDim2.new(1,-47,1,0)
    Text.Position = UDim2.fromOffset(45,0)
    Text.BackgroundTransparency = 1
    Text.Text = name
    Text.TextColor3 = Color.White
    Text.TextSize = 10
    Text.Font = Enum.Font.GothamSemibold
    Text.TextXAlignment = Enum.TextXAlignment.Left
    Text.TextYAlignment = Enum.TextYAlignment.Center
    Text.TextTruncate = Enum.TextTruncate.AtEnd
    Text.ZIndex = 16
    Text.Parent = Button

    Button.MouseEnter:Connect(function()
        TweenService:Create(
            Button,
            TweenInfo.new(.12),
            {BackgroundColor3=Color.CardHover}
        ):Play()
    end)

    Button.MouseLeave:Connect(function()
        TweenService:Create(
            Button,
            TweenInfo.new(.12),
            {BackgroundColor3=Color.Card}
        ):Play()
    end)

    Button.MouseButton1Click:Connect(function()
        Run(code)
    end)
end

local function ShowScripts(category)
    Current = category
    PageTitle.Text = category
    PageSub.Text = #Scripts[category].." scripts có sẵn"

    Home.Visible = false
    ScriptPage.Visible = true

    ClearScripts()

    local Query = string.lower(Search.Text or "")
    local Count = 0

    for _,item in ipairs(Scripts[category]) do
        if Query == "" or string.find(string.lower(item[1]),Query,1,true) then
            Count += 1
            AddScript(item[1],item[2],Count)
        end
    end

    if Count == 0 then
        local Empty = Instance.new("TextLabel")
        Empty.Name = "Empty"
        Empty.Size = UDim2.new(1,0,0,50)
        Empty.BackgroundTransparency = 1
        Empty.Text = "Không tìm thấy script"
        Empty.TextColor3 = Color.Gray
        Empty.TextSize = 12
        Empty.Font = Enum.Font.GothamMedium
        Empty.ZIndex = 16
        Empty.Parent = ScriptScroll
    end

    ScriptScroll.CanvasPosition = Vector2.zero
end
--// QUOC ANH MENU - PART 3/3

local function ShowHome()
    Current = "Home"
    PageTitle.Text = "Home"
    PageSub.Text = "Welcome back, Owner"

    Home.Visible = true
    ScriptPage.Visible = false
end

local SideButtons = {}

local function MakeSideButton(name,icon,order)
    local Button = Instance.new("TextButton")
    Button.Name = name
    Button.Size = UDim2.new(1,0,0,41)
    Button.BackgroundColor3 = Color.Card
    Button.BackgroundTransparency = .28
    Button.BorderSizePixel = 0
    Button.Text = ""
    Button.AutoButtonColor = false
    Button.LayoutOrder = order
    Button.ZIndex = 14
    Button.Parent = SideList

    Instance.new("UICorner",Button).CornerRadius = UDim.new(0,9)

    local Icon = Instance.new("TextLabel")
    Icon.Size = UDim2.fromOffset(36,41)
    Icon.BackgroundTransparency = 1
    Icon.Text = icon
    Icon.TextColor3 = Color.White
    Icon.TextSize = 13
    Icon.Font = Enum.Font.GothamBold
    Icon.ZIndex = 16
    Icon.Parent = Button

    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.new(1,-42,1,0)
    Label.Position = UDim2.fromOffset(38,0)
    Label.BackgroundTransparency = 1
    Label.Text = name
    Label.TextColor3 = Color.White
    Label.TextSize = 9
    Label.Font = Enum.Font.GothamSemibold
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.ZIndex = 16
    Label.Parent = Button

    SideButtons[name] = Button

    Button.MouseEnter:Connect(function()
        TweenService:Create(
            Button,
            TweenInfo.new(.12),
            {BackgroundColor3=Color.CardHover}
        ):Play()
    end)

    Button.MouseLeave:Connect(function()
        if Current ~= name then
            TweenService:Create(
                Button,
                TweenInfo.new(.12),
                {BackgroundColor3=Color.Card}
            ):Play()
        end
    end)

    Button.MouseButton1Click:Connect(function()
        if name == "Home" then
            ShowHome()
        else
            ShowScripts(name)
        end

        for n,b in pairs(SideButtons) do
            b.BackgroundColor3 = Color.Card
        end

        Button.BackgroundColor3 = Color.CardHover
    end)
end

MakeSideButton("Home","⌂",1)
MakeSideButton("Steal a Egg","🥚",2)
MakeSideButton("Blox Fruit","B",3)
MakeSideButton("Blade Ball","⚔",4)

for name,button in pairs(CategoryButtons) do
    button.MouseEnter:Connect(function()
        TweenService:Create(
            button,
            TweenInfo.new(.12),
            {BackgroundColor3=Color.CardHover}
        ):Play()
    end)

    button.MouseLeave:Connect(function()
        TweenService:Create(
            button,
            TweenInfo.new(.12),
            {BackgroundColor3=Color.Card}
        ):Play()
    end)

    button.MouseButton1Click:Connect(function()
        ShowScripts(name)

        for n,b in pairs(SideButtons) do
            b.BackgroundColor3 = Color.Card
        end

        if SideButtons[name] then
            SideButtons[name].BackgroundColor3 = Color.CardHover
        end
    end)
end

Search:GetPropertyChangedSignal("Text"):Connect(function()
    if Current ~= "Home" and Scripts[Current] then
        ShowScripts(Current)
    end
end)

--// NÚT TRÒN 👑
--// Giữ nguyên kiểu nút bro đã thích

local Crown = Instance.new("TextButton")
Crown.Name = "CrownButton"
Crown.Size = UDim2.fromOffset(44,44)
Crown.Position = UDim2.new(0,25,.5,-22)
Crown.BackgroundColor3 = Color.Black
Crown.BackgroundTransparency = .03
Crown.BorderSizePixel = 0
Crown.Text = "👑"
Crown.TextColor3 = Color.White
Crown.TextSize = 21
Crown.Font = Enum.Font.GothamBold
Crown.AutoButtonColor = false
Crown.ZIndex = 100
Crown.Parent = Gui

Instance.new("UICorner",Crown).CornerRadius = UDim.new(1,0)

local CrownStroke = Instance.new("UIStroke",Crown)
CrownStroke.Color = Color.Line
CrownStroke.Thickness = 1.5

Crown.MouseEnter:Connect(function()
    TweenService:Create(
        Crown,
        TweenInfo.new(.12),
        {BackgroundColor3=Color.CardHover}
    ):Play()
end)

Crown.MouseLeave:Connect(function()
    TweenService:Create(
        Crown,
        TweenInfo.new(.12),
        {BackgroundColor3=Color.Black}
    ):Play()
end)

local Open = true

Crown.MouseButton1Click:Connect(function()
    Open = not Open
    Main.Visible = Open
end)

--// KÉO MENU

local Dragging = false
local DragStart
local StartPos

Header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then

        Dragging = true
        DragStart = input.Position
        StartPos = Main.Position

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                Dragging = false
            end
        end)
    end
end)

UIS.InputChanged:Connect(function(input)
    if Dragging and
    (input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch) then

        local Delta = input.Position - DragStart

        Main.Position = UDim2.new(
            StartPos.X.Scale,
            StartPos.X.Offset + Delta.X,
            StartPos.Y.Scale,
            StartPos.Y.Offset + Delta.Y
        )
    end
end)

--// KÉO NÚT 👑

local CrownDragging = false
local CrownStart
local CrownPos

Crown.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then

        CrownDragging = true
        CrownStart = input.Position
        CrownPos = Crown.Position

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                CrownDragging = false
            end
        end)
    end
end)

UIS.InputChanged:Connect(function(input)
    if CrownDragging and
    (input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch) then

        local Delta = input.Position - CrownStart

        Crown.Position = UDim2.new(
            CrownPos.X.Scale,
            CrownPos.X.Offset + Delta.X,
            CrownPos.Y.Scale,
            CrownPos.Y.Offset + Delta.Y
        )
    end
end)

--// HOME MẶC ĐỊNH

ShowHome()

if SideButtons.Home then
    SideButtons.Home.BackgroundColor3 = Color.CardHover
end

print("👑 QuocAnhMenu loaded - AdminVNGx Owner")
