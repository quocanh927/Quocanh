        local Name = Instance.new("TextLabel")
        Name.Size = UDim2.fromOffset(130,22)
        Name.Position = UDim2.fromOffset(10,8)
        Name.BackgroundTransparency = 1
        Name.Text = data.Name
        Name.TextColor3 = C.White
        Name.Font = Enum.Font.GothamBold
        Name.TextSize = 10
        Name.TextXAlignment = Enum.TextXAlignment.Left
        Name.TextTruncate = Enum.TextTruncate.AtEnd
        Name.Parent = Card

        if data.Key then
            local Key = Instance.new("TextLabel")
            Key.Size = UDim2.fromOffset(28,15)
            Key.Position = UDim2.fromOffset(10,34)
            Key.BackgroundTransparency = 1
            Key.Text = "KEY"
            Key.TextColor3 = Color3.fromRGB(160,165,255)
            Key.Font = Enum.Font.GothamBold
            Key.TextSize = 7
            Key.TextXAlignment = Enum.TextXAlignment.Left
            Key.Parent = Card
        end

        local Run = Instance.new("TextButton")
        Run.Size = UDim2.fromOffset(55,30)
        Run.Position = UDim2.new(1,-65,0,16)
        Run.BackgroundColor3 = Color3.fromRGB(35,38,48)
        Run.BorderSizePixel = 0
        Run.Text = "RUN"
        Run.TextColor3 = C.White
        Run.Font = Enum.Font.GothamBold
        Run.TextSize = 9
        Run.AutoButtonColor = false
        Run.Parent = Card

        local RunCorner = Instance.new("UICorner")
        RunCorner.CornerRadius = UDim.new(0,8)
        RunCorner.Parent = Run

        Run.MouseEnter:Connect(function()
            TweenService:Create(
                Run,
                TweenInfo.new(.15),
                {BackgroundColor3 = C.Blue}
            ):Play()
        end)

        Run.MouseLeave:Connect(function()
            TweenService:Create(
                Run,
                TweenInfo.new(.15),
                {BackgroundColor3 = Color3.fromRGB(35,38,48)}
            ):Play()
        end)

        Run.MouseButton1Click:Connect(function()
            RunCode(data.Code)
        end)

        table.insert(Cards,Card)
    end

    --// SHOW CATEGORY
    local function ShowCategory(category)
        CurrentCategory = category
        ClearCards()

        for _,data in ipairs(Scripts[category] or {}) do
            AddScript(data)
        end
    end

    --// SIDEBAR BUTTON
    local function AddSideButton(text,category)
        local Button = Instance.new("TextButton")
        Button.Size = UDim2.fromOffset(126,42)
        Button.BackgroundColor3 = C.Card
        Button.BorderSizePixel = 0
        Button.Text = text
        Button.TextColor3 = C.Gray
        Button.Font = Enum.Font.GothamBold
        Button.TextSize = 10
        Button.AutoButtonColor = false
        Button.Parent = Side

        local Corner = Instance.new("UICorner")
        Corner.CornerRadius = UDim.new(0,10)
        Corner.Parent = Button

        Button.MouseButton1Click:Connect(function()
            ShowCategory(category)

            for _,obj in ipairs(Side:GetChildren()) do
                if obj:IsA("TextButton") then
                    obj.BackgroundColor3 = C.Card
                    obj.TextColor3 = C.Gray
                end
            end

            Button.BackgroundColor3 = Color3.fromRGB(35,38,50)
            Button.TextColor3 = C.White
        end)

        Button.MouseEnter:Connect(function()
            if Button.BackgroundColor3 == C.Card then
                TweenService:Create(
                    Button,
                    TweenInfo.new(.12),
                    {BackgroundColor3 = C.Hover}
                ):Play()
            end
        end)

        return Button
    end

    AddSideButton("⌂  Home","Home")
    AddSideButton("🥚  Steal a Egg","Steal a Egg")
    AddSideButton("🍎  Blox Fruit","Blox Fruit")
    AddSideButton("⚔  Blade Ball","Blade Ball")

    --// HOME
    Scripts.Home = {}

    local function ShowHome()
        ClearCards()

        local Home = Instance.new("TextLabel")
        Home.Size = UDim2.new(1,-30,1,-20)
        Home.Position = UDim2.fromOffset(15,10)
        Home.BackgroundTransparency = 1
        Home.Text =
            "Xin chào tôi là 👑 OWNER 👑\n\n" ..
            "QuocAnhMenu Premium hiện đang được phát triển.\n" ..
            "Đây là script tổng hợp nhiều script khác.\n\n" ..
            "Nếu script nào yêu cầu key, mình sẽ ghi chữ KEY nhỏ ở sau.\n\n" ..
            "★ PREMIUM ACCESS"
        Home.TextColor3 = C.White
        Home.Font = Enum.Font.GothamMedium
        Home.TextSize = 12
        Home.TextWrapped = true
        Home.TextXAlignment = Enum.TextXAlignment.Left
        Home.TextYAlignment = Enum.TextYAlignment.Top
        Home.Parent = Scroll

        table.insert(Cards,Home)
    end

    --// SEARCH
    Search:GetPropertyChangedSignal("Text"):Connect(function()
        local Query = Search.Text:lower()

        for _,Card in ipairs(Cards) do
            if Card:IsA("Frame") then
                local Label = Card:FindFirstChildWhichIsA("TextLabel")

                if Label then
                    Card.Visible =
                        Query == ""
                        or Label.Text:lower():find(Query,1,true) ~= nil
                end
            end
        end
    end)

    --// CLOSE
    Close.MouseButton1Click:Connect(function()
        MenuGui:Destroy()
    end)

    --// DRAG MENU
    local Dragging = false
    local DragStart
    local StartPos

    Header.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

            Dragging = true
            DragStart = input.Position
            StartPos = Menu.Position

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    Dragging = false
                end
            end)
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if Dragging and (
            input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch
        ) then

            local Delta = input.Position - DragStart

            Menu.Position = UDim2.new(
                StartPos.X.Scale,
                StartPos.X.Offset + Delta.X,
                StartPos.Y.Scale,
                StartPos.Y.Offset + Delta.Y
            )
        end
    end)

    --// FLOATING BUTTON
    local Toggle = Instance.new("ImageButton")
    Toggle.Size = UDim2.fromOffset(48,48)
    Toggle.Position = UDim2.new(0,15,.5,-24)
    Toggle.BackgroundColor3 = C.Black
    Toggle.BackgroundTransparency = .05
    Toggle.BorderSizePixel = 0
    Toggle.Image = IMAGE_ID
    Toggle.ScaleType = Enum.ScaleType.Crop
    Toggle.ClipsDescendants = true
    Toggle.ZIndex = 100
    Toggle.Parent = MenuGui

    local ToggleCorner = Instance.new("UICorner")
    ToggleCorner.CornerRadius = UDim.new(1,0)
    ToggleCorner.Parent = Toggle

    local ToggleStroke = Instance.new("UIStroke")
    ToggleStroke.Color = C.Blue
    ToggleStroke.Thickness = 1.5
    ToggleStroke.Parent = Toggle

    Toggle.MouseButton1Click:Connect(function()
        Menu.Visible = not Menu.Visible
    end)

    --// DEFAULT
    ShowHome()

    --// CLOSE KEY SYSTEM
    Gui:Destroy()
end

--//==================================================
--// CHECK KEY
--//==================================================

Check.MouseButton1Click:Connect(function()

    local InputKey = KeyBox.Text

    if InputKey == PREMIUM_KEY then

        Status.Text = "✓ Premium Key hợp lệ • Loading..."
        Status.TextColor3 = C.Green

        Check.Text = "✓  VERIFIED"

        task.wait(.8)

        StartPremiumMenu()

    else

        Status.Text = "✕ Key không đúng!"
        Status.TextColor3 = C.Red

        TweenService:Create(
            MainStroke,
            TweenInfo.new(.12),
            {Color = C.Red}
        ):Play()

        task.wait(.3)

        TweenService:Create(
            MainStroke,
            TweenInfo.new(.25),
            {Color = C.Line}
        ):Play()
    end
end)

--// GET KEY
GetKey.MouseButton1Click:Connect(function()
    Status.Text = "Key: QUOCANH-PREMIUM"
    Status.TextColor3 = C.Blue

    if setclipboard then
        pcall(function()
            setclipboard(PREMIUM_KEY)
        end)
    end
end)
