local Slider = Instance.new("TextButton")
Slider.Size = UDim2.new(1,-30,0,8)
Slider.Position = UDim2.fromOffset(15,151)
Slider.BackgroundColor3 = Color3.fromRGB(55,55,55)
Slider.Text = ""
Slider.AutoButtonColor = false
Slider.Parent = Main

local SC = Instance.new("UICorner")
SC.CornerRadius = UDim.new(1,0)
SC.Parent = Slider

local Fill = Instance.new("Frame")
Fill.Size = UDim2.new((_G.HeadSize-1)/49,0,1,0)
Fill.BackgroundColor3 = _G.HitBoxColor
Fill.BorderSizePixel = 0
Fill.Parent = Slider

local FC = Instance.new("UICorner")
FC.CornerRadius = UDim.new(1,0)
FC.Parent = Fill

local sliding = false

local function SetSize(x)
    local percent = math.clamp(
        (x-Slider.AbsolutePosition.X)/
        Slider.AbsoluteSize.X,
        0,1
    )

    _G.HeadSize = math.floor(1+percent*49)

    Fill.Size = UDim2.new(percent,0,1,0)
    SizeLabel.Text = "HitBox Size     ".._G.HeadSize
end

Slider.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        sliding = true
        SetSize(input.Position.X)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if sliding then
        if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
            SetSize(input.Position.X)
        end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        sliding = false
    end
end)

local function ToggleAnimation(button,knob,state)
    TweenService:Create(
        button,
        TweenInfo.new(.22,Enum.EasingStyle.Quad),
        {
            BackgroundColor3 =
                state
                and Color3.fromRGB(255,195,35)
                or Color3.fromRGB(60,60,60)
        }
    ):Play()

    TweenService:Create(
        knob,
        TweenInfo.new(.25,Enum.EasingStyle.Back),
        {
            Position =
                state
                and UDim2.new(1,-25,0,3)
                or UDim2.fromOffset(3,3)
        }
    ):Play()
end

HitToggle.MouseButton1Click:Connect(function()
    _G.Disabled = not _G.Disabled

    ToggleAnimation(
        HitToggle,
        HitKnob,
        _G.Disabled
    )
end)

ESPToggle.MouseButton1Click:Connect(function()
    _G.ESP = not _G.ESP

    ToggleAnimation(
        ESPToggle,
        ESPKnob,
        _G.ESP
    )
end)
