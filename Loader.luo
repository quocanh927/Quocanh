-- 👑 QUOC ANH HITBOX - PART 3/5
-- COLOR PANEL + RAINBOW
--========================================================

local ColorButton = Instance.new("TextButton")
ColorButton.Size = UDim2.new(1,-30,0,36)
ColorButton.Position = UDim2.fromOffset(15,174)
ColorButton.BackgroundColor3 = Color3.fromRGB(40,40,40)
ColorButton.BorderSizePixel = 0
ColorButton.Text = "🎨  Chọn màu"
ColorButton.TextColor3 = Color3.new(1,1,1)
ColorButton.TextSize = 13
ColorButton.Font = Enum.Font.GothamBold
ColorButton.AutoButtonColor = false
ColorButton.Parent = Main

local ColorCorner = Instance.new("UICorner")
ColorCorner.CornerRadius = UDim.new(0,8)
ColorCorner.Parent = ColorButton

local ColorPanel = Instance.new("Frame")
ColorPanel.Size = UDim2.new(1,-30,0,48)
ColorPanel.Position = UDim2.fromOffset(15,215)
ColorPanel.BackgroundColor3 = Color3.fromRGB(30,30,30)
ColorPanel.BorderSizePixel = 0
ColorPanel.Visible = false
ColorPanel.Parent = Main

local PanelCorner = Instance.new("UICorner")
PanelCorner.CornerRadius = UDim.new(0,8)
PanelCorner.Parent = ColorPanel

local ColorList = {
    {"Đỏ",Color3.fromRGB(255,70,70)},
    {"Xanh",Color3.fromRGB(70,140,255)},
    {"Lá",Color3.fromRGB(70,255,120)},
    {"Vàng",Color3.fromRGB(255,210,45)},
    {"🌈",nil}
}

for i,data in ipairs(ColorList) do

    local button = Instance.new("TextButton")

    button.Size = UDim2.fromOffset(45,30)

    button.Position =
        UDim2.fromOffset(
            7+(i-1)*51,
            9
        )

    button.BackgroundColor3 =
        data[2]
        or Color3.fromRGB(255,100,220)

    button.BorderSizePixel = 0

    button.Text = data[1]

    button.TextColor3 =
        Color3.new(1,1,1)

    button.TextSize = 9
    button.Font = Enum.Font.GothamBold

    button.Parent = ColorPanel

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0,6)
    corner.Parent = button

    button.MouseButton1Click:Connect(function()

        if data[1] == "🌈" then

            Settings.Rainbow = true

        else

            Settings.Rainbow = false
            Settings.HitBoxColor = data[2]

            Fill.BackgroundColor3 =
                data[2]

        end

    end)

end

local ColorOpen = false

ColorButton.MouseButton1Click:Connect(function()

    ColorOpen = not ColorOpen

    ColorPanel.Visible = ColorOpen

    if ColorOpen then

        Main.Size =
            UDim2.fromOffset(285,275)

    else

        Main.Size =
            UDim2.fromOffset(285,245)

    end

end)

local function GetColor()

    if Settings.Rainbow then

        return Color3.fromHSV(
            (os.clock()%5)/5,
            1,
            1
        )

    end

    return Settings.HitBoxColor

end

local function RemoveESP(character)

    if not character then
        return
    end

    local old =
        character:FindFirstChild(
            "QuocAnhESP"
        )

    if old then
        old:Destroy()
    end

end

local function AddESP(character)

    if not character then
        return
    end

    local humanoid =
        character:FindFirstChildOfClass(
            "Humanoid"
        )

    if not humanoid then
        return
    end

    local old =
        character:FindFirstChild(
            "QuocAnhESP"
        )

    if old then
        old:Destroy()
    end

    local highlight =
        Instance.new("Highlight")

    highlight.Name =
        "QuocAnhESP"

    highlight.DepthMode =
        Enum.HighlightDepthMode.AlwaysOnTop

    highlight.FillTransparency = .78
    highlight.OutlineTransparency = 0

    highlight.FillColor =
        GetColor()

    highlight.OutlineColor =
        GetColor()

    highlight.Parent =
        character

end
--========================================================
-- 👑 QUOC ANH HITBOX - PART 4/5
-- ENEMY + TEAM + NPC + HITBOX
--========================================================

local function IsEnemy(player)

    if player == LocalPlayer then
        return false
    end

    if LocalPlayer.Team ~= nil
    and player.Team ~= nil then

        return player.Team ~= LocalPlayer.Team

    end

    return true
end

local function ApplyHitBox(character)

    if not character then
        return
    end

    local humanoid =
        character:FindFirstChildOfClass(
            "Humanoid"
        )

    local hrp =
        character:FindFirstChild(
            "HumanoidRootPart"
        )

    if not humanoid or not hrp then
        return
    end

    if humanoid.Health <= 0 then
        return
    end

    pcall(function()

        hrp.Size = Vector3.new(
            Settings.HitBoxSize,
            Settings.HitBoxSize,
            Settings.HitBoxSize
        )

        hrp.Transparency =
            Settings.HitBoxTransparency

        hrp.Color =
            GetColor()

        hrp.Material =
            Enum.Material.Neon

        hrp.CanCollide = false

    end)

end

local function UpdatePlayer(player)

    if player == LocalPlayer then
        return
    end

    if not IsEnemy(player) then

        if player.Character then
            RemoveESP(player.Character)
        end

        return
    end

    local character =
        player.Character

    if not character then
        return
    end

    local humanoid =
        character:FindFirstChildOfClass(
            "Humanoid"
        )

    if not humanoid then
        return
    end

    if humanoid.Health <= 0 then
        return
    end

    if Settings.HitBoxEnabled then
        ApplyHitBox(character)
    end

    if Settings.ESPEnabled then
        AddESP(character)
    else
        RemoveESP(character)
    end

end

local function UpdateNPC(model)

    if not model then
        return
    end

    if not model:IsA("Model") then
        return
    end

    -- Không xử lý Player Character
    if Players:GetPlayerFromCharacter(model) then
        return
    end

    local humanoid =
        model:FindFirstChildOfClass(
            "Humanoid"
        )

    local hrp =
        model:FindFirstChild(
            "HumanoidRootPart"
        )

    if not humanoid or not hrp then
        return
    end

    if humanoid.Health <= 0 then
        return
    end

    if Settings.HitBoxEnabled then
        ApplyHitBox(model)
    end

    if Settings.ESPEnabled then
        AddESP(model)
    else
        RemoveESP(model)
    end

end

local function UpdateAll()

    for _,player in ipairs(
        Players:GetPlayers()
    ) do

        UpdatePlayer(player)

    end

    for _,object in ipairs(
        workspace:GetDescendants()
    ) do

        if object:IsA("Model") then
            UpdateNPC(object)
        end

    end

end

--========================================================
-- PLAYER SPAWN / RESPAWN
--========================================================

local function SetupPlayer(player)

    player.CharacterAdded:Connect(
        function(character)

            local humanoid =
                character:WaitForChild(
                    "Humanoid",
                    10
                )

            local hrp =
                character:WaitForChild(
                    "HumanoidRootPart",
                    10
                )

            if not humanoid or not hrp then
                return
            end

            task.wait(.1)

            if player.Character == character
            and humanoid.Health > 0 then

                UpdatePlayer(player)

            end

            task.wait(.25)

            if player.Character == character
            and humanoid.Health > 0 then

                UpdatePlayer(player)

            end

        end
    )

    if player.Character then

        task.defer(function()

            task.wait(.1)

            UpdatePlayer(player)

        end)

    end

end

for _,player in ipairs(
    Players:GetPlayers()
) do

    SetupPlayer(player)

end

Players.PlayerAdded:Connect(
    function(player)

        SetupPlayer(player)

    end
)

--========================================================
-- NPC SPAWN
--========================================================

workspace.DescendantAdded:Connect(
    function(object)

        if not object:IsA("Model") then
            return
        end

        task.defer(function()

            task.wait(.15)

            if object.Parent then
                UpdateNPC(object)
            end

        end)

    end
)
--========================================================
-- 👑 QUOC ANH HITBOX - PART 5/5
-- UPDATE + RAINBOW + OPEN/CLOSE
--========================================================

--========================================================
-- OPEN / CLOSE
--========================================================

local MenuOpen = false

OpenButton.MouseButton1Click:Connect(function()

    MenuOpen = not MenuOpen

    if MenuOpen then

        Main.Visible = true

        Main.Size =
            UDim2.fromOffset(250,215)

        TweenService:Create(
            Main,

            TweenInfo.new(
                .28,
                Enum.EasingStyle.Back,
                Enum.EasingDirection.Out
            ),

            {
                Size =
                    ColorOpen
                    and UDim2.fromOffset(285,275)
                    or UDim2.fromOffset(285,245)
            }

        ):Play()

        TweenService:Create(
            OpenButton,

            TweenInfo.new(.2),

            {
                Rotation = 90
            }

        ):Play()

    else

        TweenService:Create(
            Main,

            TweenInfo.new(
                .18,
                Enum.EasingStyle.Quad,
                Enum.EasingDirection.In
            ),

            {
                Size =
                    UDim2.fromOffset(250,215)
            }

        ):Play()

        TweenService:Create(
            OpenButton,

            TweenInfo.new(.2),

            {
                Rotation = 0
            }

        ):Play()

        task.delay(.18,function()

            if not MenuOpen then
                Main.Visible = false
            end

        end)

    end

end)

--========================================================
-- CONTINUOUS UPDATE
--========================================================

local UpdateTimer = 0

RunService.Heartbeat:Connect(function(dt)

    UpdateTimer += dt

    -- Không cần quét workspace mỗi frame
    if UpdateTimer < 0.15 then
        return
    end

    UpdateTimer = 0

    if not Settings.HitBoxEnabled
    and not Settings.ESPEnabled then
        return
    end

    for _,player in ipairs(
        Players:GetPlayers()
    ) do

        if player ~= LocalPlayer
        and IsEnemy(player) then

            UpdatePlayer(player)

        end

    end

    for _,object in ipairs(
        workspace:GetDescendants()
    ) do

        if object:IsA("Model")
        and not Players:GetPlayerFromCharacter(object) then

            UpdateNPC(object)

        end

    end

end)

--========================================================
-- RAINBOW UPDATE
--========================================================

RunService.RenderStepped:Connect(function()

    if not Settings.Rainbow then
        return
    end

    local color = GetColor()

    Fill.BackgroundColor3 = color

    for _,player in ipairs(
        Players:GetPlayers()
    ) do

        if player ~= LocalPlayer
        and IsEnemy(player)
        and player.Character then

            local character =
                player.Character

            local hrp =
                character:FindFirstChild(
                    "HumanoidRootPart"
                )

            if Settings.HitBoxEnabled
            and hrp then

                hrp.Color = color

            end

            local esp =
                character:FindFirstChild(
                    "QuocAnhESP"
                )

            if esp then

                esp.FillColor = color
                esp.OutlineColor = color

            end

        end

    end

    for _,object in ipairs(
        workspace:GetDescendants()
    ) do

        if object:IsA("Model")
        and not Players:GetPlayerFromCharacter(object) then

            local hrp =
                object:FindFirstChild(
                    "HumanoidRootPart"
                )

            if Settings.HitBoxEnabled
            and hrp then

                hrp.Color = color

            end

            local esp =
                object:FindFirstChild(
                    "QuocAnhESP"
                )

            if esp then

                esp.FillColor = color
                esp.OutlineColor = color

            end

        end

    end

end)

--========================================================
-- INITIAL STATE
--========================================================

ToggleAnimation(
    HitToggle,
    HitKnob,
    Settings.HitBoxEnabled
)

ToggleAnimation(
    ESPToggle,
    ESPKnob,
    Settings.ESPEnabled
)

print("👑 Quoc Anh HitBox loaded")
