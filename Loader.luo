--==================================================
-- HOVER EFFECT
--==================================================

local function Hover(button,normal,hover)
    button.MouseEnter:Connect(function()
        TweenService:Create(
            button,
            TweenInfo.new(0.15),
            {
                BackgroundColor3 = hover
            }
        ):Play()
    end)

    button.MouseLeave:Connect(function()
        TweenService:Create(
            button,
            TweenInfo.new(0.15),
            {
                BackgroundColor3 = normal
            }
        ):Play()
    end)
end

Hover(Check, Color3.fromRGB(75,75,220), Color3.fromRGB(95,95,250))
Hover(GetKey, Color3.fromRGB(28,28,35), Color3.fromRGB(42,42,52))

--==================================================
-- LOADING 8 SECONDS
--==================================================

task.spawn(function()

    local duration = 8
    local startTime = os.clock()

    while true do

        local elapsed = os.clock() - startTime
        local progress = math.clamp(elapsed / duration,0,1)

        local percent = math.floor(progress * 100)

        if percent < 1 then
            percent = 1
        end

        Bar.Size = UDim2.new(progress,0,1,0)
        Status.Text = percent .. "%"

        if percent < 25 then
            LoadSub.Text = "Preparing interface..."
        elseif percent < 50 then
            LoadSub.Text = "Loading key system..."
        elseif percent < 75 then
            LoadSub.Text = "Checking configuration..."
        elseif percent < 100 then
            LoadSub.Text = "Almost ready..."
        else
            LoadSub.Text = "Welcome to QuocAnhMenu"
        end

        if progress >= 1 then
            break
        end

        task.wait(0.04)
    end

    Bar.Size = UDim2.new(1,0,1,0)
    Status.Text = "100%"
    LoadSub.Text = "Welcome to QuocAnhMenu"

    task.wait(0.5)

    -- HIDE LOADING
    local hide = TweenService:Create(
        Loading,
        TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.In),
        {
            Size = UDim2.fromOffset(240,120),
            BackgroundTransparency = 1
        }
    )
    hide:Play()
    task.wait(0.45)
    Loading:Destroy()

    -- SHOW MAIN
    Main.Visible = true
    Main.Size = UDim2.fromOffset(320,195)

    TweenService:Create(
        Main,
        TweenInfo.new(0.55, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
        {
            Size = UDim2.fromOffset(365,225)
        }
    ):Play()

end)

--==================================================
-- CHECK KEY
--==================================================

Check.MouseButton1Click:Connect(function()

    if Box.Text == "" then
        Msg.Text = "Please enter your key."
        Msg.TextColor3 = Color3.fromRGB(255,180,80)
        return
    end

    Msg.Text = "Checking key..."
    Msg.TextColor3 = Color3.fromRGB(160,160,255)

    task.wait(1)

    -- 🔥 KIỂM TRA KEY TRONG 24H
    if isKeyValid(Box.Text) then
        Msg.Text = "✓ Key verified! Loading..."
        Msg.TextColor3 = Color3.fromRGB(80,255,120)
        task.wait(0.8)
        
        gui:Destroy()
        loadstring(game:HttpGet(LOADER_LINK))()
    else
        Msg.Text = "✕ Invalid key or expired!"
        Msg.TextColor3 = Color3.fromRGB(255,80,80)
        Box.Text = ""
    end

end)

--==================================================
-- GET KEY
--==================================================

GetKey.MouseButton1Click:Connect(function()

    Msg.Text = "Copying link to clipboard..."
    Msg.TextColor3 = Color3.fromRGB(160,160,255)

    local success = pcall(function()
        setclipboard(GET_KEY_URL)
    end)

    if success then
        Msg.Text = "✓ Link copied! Paste in browser."
        Msg.TextColor3 = Color3.fromRGB(80,255,120)
    else
        pcall(function()
            GuiService:OpenBrowserWindow(GET_KEY_URL)
        end)
        Msg.Text = "Opening key page..."
        Msg.TextColor3 = Color3.fromRGB(160,160,255)
    end

    task.wait(2)
    Msg.Text = "Waiting for key..."
    Msg.TextColor3 = Color3.fromRGB(120,120,135)

end)
