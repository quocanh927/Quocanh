-- TOGGLE ANIMATION

local function ToggleAnimation(button,knob,state)

	TweenService:Create(
		button,
		TweenInfo.new(
			0.22,
			Enum.EasingStyle.Quad,
			Enum.EasingDirection.Out
		),
		{
			BackgroundColor3 =
				state
				and Color3.fromRGB(255,195,35)
				or Color3.fromRGB(65,65,65)
		}
	):Play()

	TweenService:Create(
		knob,
		TweenInfo.new(
			0.25,
			Enum.EasingStyle.Back,
			Enum.EasingDirection.Out
		),
		{
			Position =
				state
				and UDim2.new(1,-25,0,3)
				or UDim2.fromOffset(3,3)
		}
	):Play()

end

