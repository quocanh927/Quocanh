local colorOpen = false

ColorButton.MouseButton1Click:Connect(function()
    colorOpen = not colorOpen
    ColorPanel.Visible = colorOpen

    Main.Size =
        colorOpen
        and UDim2.fromOffset(285,275)
        or UDim2.fromOffset(285,245)
end

local function GetColor()
    if _G.Rainbow then
        return Color3.fromHSV(
            (tick()%5)/5,
            1,
            1
        )
    end

    return _G.HitBoxColor
end

local function RemoveESP(character)
    local old = character:FindFirstChild("QuocAnhESP")

    if old then
        old:Destroy()
    end
end

local function AddESP(character)
    local humanoid =
        character:FindFirstChildOfClass("Humanoid")

    if not humanoid then
        return
    end

    RemoveESP(character)

    local h = Instance.new("Highlight")
    h.Name = "QuocAnhESP"
    h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    h.FillTransparency = .78
    h.OutlineTransparency = 0
    h.FillColor = GetColor()
    h.OutlineColor = GetColor()
    h.Parent = character
end
-- PART 4/4
-- HitBox + Enemy + NPC + Respawn + Open/Close

local function IsEnemy(player)

    if player == LocalPlayer then
        return false
    end

    -- Cùng team = bỏ qua
    if LocalPlayer.Team ~= nil
    and player.Team ~= nil then

        return player.Team ~= LocalPlayer.Team
    end

    return true
end

local function ApplyHitBox(character)

    local humanoid =
        character:FindFirstChildOfClass("Humanoid")

    local hrp =
        character:FindFirstChild("HumanoidRootPart")

    if not humanoid or not hrp then
        return
    end

    if humanoid.Health <= 0 then
        return
    end

    pcall(function()

        -- GIỮ NGUYÊN KIỂU HITBOX GỐC

        hrp.Size = Vector3.new(
            _G.HeadSize,
            _G.HeadSize,
            _G.HeadSize
        )

        hrp.Transparency = 0.7

        hrp.Color = GetColor()

        hrp.Material = "Neon"

        hrp.CanCollide = false

    end)
end

local function UpdatePlayer(player)

    if player == LocalPlayer then
        return
    end

    local character = player.Character

    if not character then
        return
    end

    local humanoid =
        character:FindFirstChildOfClass("Humanoid")

    if not humanoid then
        return
    end

    -- ĐỒNG ĐỘI: không ESP, không HitBox
    if not IsEnemy(player) then
        RemoveESP(character)
        return
    end

    -- CHỈ XỬ LÝ KHI CÒN SỐNG
    if humanoid.Health <= 0 then
        return
    end

    if _G.Disabled then
        ApplyHitBox(character)
    end

    if _G.ESP then
        AddESP(character)
    else
        RemoveESP(character)
    end
end

local function UpdateNPC(model)

    if not model:IsA("Model") then
        return
    end

    -- Không xử lý Player
    if Players:GetPlayerFromCharacter(model) then
        return
    end

    local humanoid =
        model:FindFirstChildOfClass("Humanoid")

    local hrp =
        model:FindFirstChild("HumanoidRootPart")

    if not humanoid or not hrp then
        return
    end

    if humanoid.Health <= 0 then
        return
    end

    if _G.Disabled then
        ApplyHitBox(model)
    end

    if _G.ESP then
        AddESP(model)
    else
        RemoveESP(model)
    end
end

local function UpdateAll()

    for _,player in ipairs(
        Players:GetPlayers()
    ) do
        UpdatePlayer(player)
    end

    for _,object in ipairs(
        workspace:GetDescendants()
    ) do
        if object:IsA("Model") then
            UpdateNPC(object)
        end
    end
end

--========================================
-- QUAN TRỌNG: NGƯỜI MỚI + RESPAWN
--========================================

local function SetupPlayer(player)

    player.CharacterAdded:Connect(function(character)

        local humanoid =
            character:WaitForChild(
                "Humanoid",
                10
            )

        local hrp =
            character:WaitForChild(
                "HumanoidRootPart",
                10
            )

        if not humanoid or not hrp then
            return
        end

        -- Cho character load hoàn chỉnh
        task.wait(.1)

        -- TỰ ÁP LẠI KHI HỒI SINH
        if humanoid.Health > 0 then
            UpdatePlayer(player)
        end

        -- Nếu game thay đổi Character vài frame sau
        task.wait(.25)

        if player.Character == character
        and humanoid.Health > 0 then
            UpdatePlayer(player)
        end
    end)

    -- Player đã có Character
    if player.Character then
        task.defer(function()
            task.wait(.1)
            UpdatePlayer(player)
        end)
    end
end

for _,player in ipairs(
    Players:GetPlayers()
) do
    SetupPlayer(player)
end

Players.PlayerAdded:Connect(function(player)
    SetupPlayer(player)
end)

--========================================
-- NPC MỚI SPAWN
--========================================

workspace.DescendantAdded:Connect(function(object)

    if not object:IsA("Model") then
        return
    end

    task.defer(function()

        task.wait(.15)

        if object.Parent then
            UpdateNPC(object)
        end

    end)
end)

--========================================
-- CẬP NHẬT LIÊN TỤC
--========================================

RunService.RenderStepped:Connect(function()

    if not _G.Disabled and not _G.ESP then
        return
    end

    for _,player in ipairs(
        Players:GetPlayers()
    ) do

        if player ~= LocalPlayer
        and IsEnemy(player)
        and player.Character then

            UpdatePlayer(player)
        end
    end

    for _,object in ipairs(
        workspace:GetDescendants()
    ) do

        if object:IsA("Model")
        and not Players:GetPlayerFromCharacter(object) then

            UpdateNPC(object)
        end
    end
end)

--========================================
-- MỞ / ĐÓNG MENU
--========================================

local menuOpen = false

Open.MouseButton1Click:Connect(function()

    menuOpen = not menuOpen

    if menuOpen then

        Main.Visible = true
        Main.Size = UDim2.fromOffset(250,215)

        TweenService:Create(
            Main,
            TweenInfo.new(
                .28,
                Enum.EasingStyle.Back,
                Enum.EasingDirection.Out
            ),
            {
                Size =
                    colorOpen
                    and UDim2.fromOffset(285,275)
                    or UDim2.fromOffset(285,245)
            }
        ):Play()

    else

        TweenService:Create(
            Main,
            TweenInfo.new(.18),
            {
                Size = UDim2.fromOffset(250,215)
            }
        ):Play()

        task.wait(.18)

        Main.Visible = false
    end
end)

--========================================
-- KHỞI ĐỘNG
--========================================

ToggleAnimation(
    HitToggle,
    HitKnob,
    _G.Disabled
)

ToggleAnimation(
    ESPToggle,
    ESPKnob,
    _G.ESP
)

UpdateAll()
