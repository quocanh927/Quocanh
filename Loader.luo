--==================================================
-- HITBOX
--==================================================

local function isEnemy(player)
    if player == LocalPlayer then
        return false
    end

    if LocalPlayer.Team and player.Team then
        return LocalPlayer.Team ~= player.Team
    end

    return true
end

local function getColor()
    if Settings.Rainbow then
        return Color3.fromHSV((tick()%5)/5,1,1)
    end

    return Settings.Color
end

local function applyHitbox(character)
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local hrp = character:FindFirstChild("HumanoidRootPart")

    if not humanoid or not hrp or humanoid.Health <= 0 then
        return
    end

    if not hrp:GetAttribute("QA_Saved") then
        hrp:SetAttribute("QA_Saved",true)
        hrp:SetAttribute("QA_Size",hrp.Size)
        hrp:SetAttribute("QA_Transparency",hrp.Transparency)
        hrp:SetAttribute("QA_CanCollide",hrp.CanCollide)
    end

    hrp.Size = Vector3.new(
        Settings.Size,
        Settings.Size,
        Settings.Size
    )

    hrp.Transparency = 0.7
    hrp.CanCollide = false
    hrp.Material = Enum.Material.Neon
    hrp.Color = getColor()

    hrp:SetAttribute("QA_HitBox",true)
end

local function removeHitbox(character)
    local hrp = character and character:FindFirstChild("HumanoidRootPart")

    if not hrp or not hrp:GetAttribute("QA_Saved") then
        return
    end

    hrp.Size = hrp:GetAttribute("QA_Size") or Vector3.new(2,2,1)
    hrp.Transparency = hrp:GetAttribute("QA_Transparency") or 0
    hrp.CanCollide = hrp:GetAttribute("QA_CanCollide")

    hrp:SetAttribute("QA_HitBox",false)
end

--==================================================
-- ESP
--==================================================

local function removeESP(character)
    local esp = character:FindFirstChild("QuocAnhESP")

    if esp then
        esp:Destroy()
    end
end

local function applyESP(character)
    local humanoid = character:FindFirstChildOfClass("Humanoid")

    if not humanoid then
        return
    end

    removeESP(character)

    local h = Instance.new("Highlight")
    h.Name = "QuocAnhESP"
    h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    h.FillTransparency = 0.78
    h.OutlineTransparency = 0
    h.FillColor = getColor()
    h.OutlineColor = getColor()
    h.Parent = character
end
-- PART 4/4
-- PLAYER + NPC + RESPAWN + BUTTON + OPEN/CLOSE

local function updatePlayer(player)
    if player == LocalPlayer or not player.Character then
        return
    end

    local character = player.Character

    -- Đồng đội: không hitbox + không ESP
    if not isEnemy(player) then
        removeHitbox(character)
        removeESP(character)
        return
    end

    if Settings.HitBoxEnabled then
        applyHitbox(character)
    else
        removeHitbox(character)
    end

    if Settings.ESPEnabled then
        applyESP(character)
    else
        removeESP(character)
    end
end

local function updateNPC(model)
    if not model:IsA("Model") then
        return
    end

    -- Không xử lý Player Character
    if Players:GetPlayerFromCharacter(model) then
        return
    end

    local humanoid = model:FindFirstChildOfClass("Humanoid")

    if not humanoid then
        return
    end

    if Settings.HitBoxEnabled then
        applyHitbox(model)
    else
        removeHitbox(model)
    end

    if Settings.ESPEnabled then
        applyESP(model)
    else
        removeESP(model)
    end
end

local function updateAll()
    for _,player in ipairs(Players:GetPlayers()) do
        updatePlayer(player)
    end

    for _,object in ipairs(workspace:GetDescendants()) do
        if object:IsA("Model") then
            updateNPC(object)
        end
    end
end

-- PLAYER / RESPAWN
local function setupPlayer(player)
    player.CharacterAdded:Connect(function(character)
        task.wait(0.25)
        updatePlayer(player)
    end)
end

for _,player in ipairs(Players:GetPlayers()) do
    setupPlayer(player)
end

Players.PlayerAdded:Connect(function(player)
    setupPlayer(player)

    task.wait(0.25)
    updatePlayer(player)
end)

--==================================================
-- BUTTON
--==================================================

Toggle.MouseButton1Click:Connect(function()
    Settings.HitBoxEnabled = not Settings.HitBoxEnabled

    animateToggle(
        Toggle,
        Knob,
        Settings.HitBoxEnabled
    )

    updateAll()
end)

ESPButton.MouseButton1Click:Connect(function()
    Settings.ESPEnabled = not Settings.ESPEnabled

    animateToggle(
        ESPButton,
        ESPKnob,
        Settings.ESPEnabled
    )

    updateAll()
end)

--==================================================
-- RAINBOW
--==================================================

RunService.RenderStepped:Connect(function()
    if not Settings.HitBoxEnabled and not Settings.ESPEnabled then
        return
    end

    local color = getColor()

    for _,player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer
        and isEnemy(player)
        and player.Character then

            local hrp = player.Character:FindFirstChild("HumanoidRootPart")

            if hrp and hrp:GetAttribute("QA_HitBox") then
                hrp.Color = color
            end

            local esp = player.Character:FindFirstChild("QuocAnhESP")

            if esp then
                esp.FillColor = color
                esp.OutlineColor = color
            end
        end
    end

    for _,object in ipairs(workspace:GetDescendants()) do
        if object:IsA("Model") then
            local humanoid = object:FindFirstChildOfClass("Humanoid")

            if humanoid then
                local hrp = object:FindFirstChild("HumanoidRootPart")
                local esp = object:FindFirstChild("QuocAnhESP")

                if hrp and hrp:GetAttribute("QA_HitBox") then
                    hrp.Color = color
                end

                if esp then
                    esp.FillColor = color
                    esp.OutlineColor = color
                end
            end
        end
    end
end)

--==================================================
-- OPEN / CLOSE MENU
--==================================================

local menuOpen = false

OpenButton.MouseButton1Click:Connect(function()
    menuOpen = not menuOpen

    if menuOpen then
        Main.Visible = true
        Main.Size = UDim2.fromOffset(260,220)

        TweenService:Create(
            Main,
            TweenInfo.new(
                0.3,
                Enum.EasingStyle.Back,
                Enum.EasingDirection.Out
            ),
            {
                Size = colorOpen
                    and UDim2.fromOffset(285,265)
                    or UDim2.fromOffset(285,245)
            }
        ):Play()

        TweenService:Create(
            OpenButton,
            TweenInfo.new(0.2),
            {Rotation = 90}
        ):Play()

    else

        TweenService:Create(
            Main,
            TweenInfo.new(
                0.2,
                Enum.EasingStyle.Quad,
                Enum.EasingDirection.In
            ),
            {
                Size = UDim2.fromOffset(260,220)
            }
        ):Play()

        TweenService:Create(
            OpenButton,
            TweenInfo.new(0.2),
            {Rotation = 0}
        ):Play()

        task.wait(0.2)
        Main.Visible = false
    end
end)

--==================================================
-- PUBLIC FUNCTIONS
--==================================================

_G.QuocAnh_SetHitBox = function(enabled)
    Settings.HitBoxEnabled = enabled == true
    animateToggle(Toggle,Knob,Settings.HitBoxEnabled)
    updateAll()
end

_G.QuocAnh_SetESP = function(enabled)
    Settings.ESPEnabled = enabled == true
    animateToggle(ESPButton,ESPKnob,Settings.ESPEnabled)
    updateAll()
end

_G.QuocAnh_SetSize = function(size)
    Settings.Size = math.clamp(
        tonumber(size) or 10,
        1,
        50
    )

    local percent = (Settings.Size-1)/49

    Fill.Size = UDim2.new(percent,0,1,0)
    SizeLabel.Text = "HitBox Size     "..Settings.Size

    updateAll()
end

_G.QuocAnh_SetColor = function(color)
    if typeof(color) == "Color3" then
        Settings.Color = color
        Settings.Rainbow = false
        Fill.BackgroundColor3 = color
        updateAll()
    end
end

_G.QuocAnh_SetRainbow = function(enabled)
    Settings.Rainbow = enabled == true
    updateAll()
end
