local Slider = Instance.new("TextButton")
Slider.Size = UDim2.new(1,-30,0,8)
Slider.Position = UDim2.fromOffset(15,146)
Slider.BackgroundColor3 = Color3.fromRGB(55,55,55)
Slider.Text = ""
Slider.AutoButtonColor = false
Slider.Parent = Main

corner(Slider,50)

local Fill = Instance.new("Frame")
Fill.Size = UDim2.new((Settings.Size-1)/49,0,1,0)
Fill.BackgroundColor3 = Settings.Color
Fill.BorderSizePixel = 0
Fill.Parent = Slider

corner(Fill,50)

local sliderDragging = false

local function updateSlider(x)
    local percent = math.clamp(
        (x-Slider.AbsolutePosition.X)/Slider.AbsoluteSize.X,
        0,1
    )

    Settings.Size = math.floor(1+percent*49)

    Fill.Size = UDim2.new(percent,0,1,0)
    SizeLabel.Text = "HitBox Size     "..Settings.Size
end

Slider.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        sliderDragging = true
        updateSlider(input.Position.X)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if sliderDragging then
        if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
            updateSlider(input.Position.X)
        end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        sliderDragging = false
    end
end)
