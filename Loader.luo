--==================================================
-- ESP
--==================================================

local function GetColor()

	if _G.Rainbow then

		return Color3.fromHSV(
			(tick()%5)/5,
			1,
			1
		)

	end

	return _G.HitBoxColor

end

local function RemoveESP(character)

	local old =
		character:FindFirstChild("QuocAnhESP")

	if old then
		old:Destroy()
	end

end

local function AddESP(character)

	local humanoid =
		character:FindFirstChildOfClass("Humanoid")

	if not humanoid then
		return
	end

	RemoveESP(character)

	local Highlight =
		Instance.new("Highlight")

	Highlight.Name =
		"QuocAnhESP"

	Highlight.DepthMode =
		Enum.HighlightDepthMode.AlwaysOnTop

	Highlight.FillTransparency =
		0.78

	Highlight.OutlineTransparency =
		0

	Highlight.FillColor =
		GetColor()

	Highlight.OutlineColor =
		GetColor()

	Highlight.Parent =
		character

end
--==================================================
-- PART 4/4
-- HITBOX CORE + PLAYER + NPC + OPEN/CLOSE
--==================================================

--==================================================
-- KIỂM TRA ĐỊCH
--==================================================

local function IsEnemy(player)

	if player == LocalPlayer then
		return false
	end

	-- Cùng Team = không HitBox / không ESP
	if LocalPlayer.Team ~= nil
	and player.Team ~= nil then

		return LocalPlayer.Team ~= player.Team

	end

	-- Nếu game không dùng Team
	-- thì Player khác được xem là địch
	return true

end

--==================================================
-- HITBOX
-- GIỮ NGUYÊN LOGIC CODE GỐC
--==================================================

local function ApplyHitBox(character)

	local humanoid =
		character:FindFirstChildOfClass("Humanoid")

	local hrp =
		character:FindFirstChild("HumanoidRootPart")

	if not humanoid or not hrp then
		return
	end

	if humanoid.Health <= 0 then
		return
	end

	pcall(function()

		hrp.Size =
			Vector3.new(
				_G.HeadSize,
				_G.HeadSize,
				_G.HeadSize
			)

		hrp.Transparency = 0.7

		if _G.Rainbow then

			hrp.Color =
				Color3.fromHSV(
					(tick()%5)/5,
					1,
					1
				)

		else

			hrp.Color =
				_G.HitBoxColor

		end

		hrp.Material = "Neon"

		hrp.CanCollide = false

	end)

end

--==================================================
-- RESTORE HITBOX
--==================================================

local OriginalData = {}

local function SaveOriginal(hrp)

	if OriginalData[hrp] then
		return
	end

	OriginalData[hrp] = {

		Size = hrp.Size,
		Transparency = hrp.Transparency,
		CanCollide = hrp.CanCollide,
		Material = hrp.Material,
		Color = hrp.Color

	}

end

local function RestoreHitBox(character)

	local hrp =
		character
		and character:FindFirstChild("HumanoidRootPart")

	if not hrp then
		return
	end

	local data =
		OriginalData[hrp]

	if data then

		hrp.Size =
			data.Size

		hrp.Transparency =
			data.Transparency

		hrp.CanCollide =
			data.CanCollide

		hrp.Material =
			data.Material

		hrp.Color =
			data.Color

		OriginalData[hrp] = nil

	end

end

--==================================================
-- PLAYER UPDATE
--==================================================

local function UpdatePlayer(player)

	if player == LocalPlayer then
		return
	end

	local character =
		player.Character

	if not character then
		return
	end

	-- ĐỒNG ĐỘI
	if not IsEnemy(player) then

		RestoreHitBox(character)
		RemoveESP(character)

		return

	end

	-- ĐỊCH
	if _G.Disabled then

		local hrp =
			character:FindFirstChild(
				"HumanoidRootPart"
			)

		if hrp then
			SaveOriginal(hrp)
		end

		ApplyHitBox(character)

	else

		RestoreHitBox(character)

	end

	-- ESP
	if _G.ESP then
		AddESP(character)
	else
		RemoveESP(character)
	end

end

--==================================================
-- NPC
--==================================================

local function UpdateNPC(model)

	if not model:IsA("Model") then
		return
	end

	-- Không xử lý Player Character
	if Players:GetPlayerFromCharacter(model) then
		return
	end

	local humanoid =
		model:FindFirstChildOfClass("Humanoid")

	local hrp =
		model:FindFirstChild("HumanoidRootPart")

	if not humanoid or not hrp then
		return
	end

	if _G.Disabled then

		SaveOriginal(hrp)
		ApplyHitBox(model)

	else

		RestoreHitBox(model)

	end

	-- NPC cũng ESP
	if _G.ESP then
		AddESP(model)
	else
		RemoveESP(model)
	end

end

--==================================================
-- UPDATE ALL
--==================================================

local function UpdateAll()

	for _,player in ipairs(
		Players:GetPlayers()
	) do

		UpdatePlayer(player)

	end

	for _,object in ipairs(
		workspace:GetDescendants()
	) do

		if object:IsA("Model") then
			UpdateNPC(object)
		end

	end

end

--==================================================
-- NGƯỜI MỚI VÀO / HỒI SINH
--==================================================

local function SetupPlayer(player)

	player.CharacterAdded:Connect(function(character)

		character:WaitForChild(
			"HumanoidRootPart",
			10
		)

		task.wait(0.15)

		-- Người mới / respawn tự nhận lại
		UpdatePlayer(player)

	end)

end

for _,player in ipairs(
	Players:GetPlayers()
) do

	SetupPlayer(player)

end

Players.PlayerAdded:Connect(function(player)

	SetupPlayer(player)

	task.wait(0.2)

	UpdatePlayer(player)

end)

-- NPC mới spawn
workspace.DescendantAdded:Connect(function(object)

	if not _G.Disabled then
		return
	end

	if object:IsA("Model") then

		task.defer(function()

			task.wait(0.1)

			UpdateNPC(object)

		end)

	end

end)

--==================================================
-- HITBOX BUTTON
--==================================================

HitBoxToggle.MouseButton1Click:Connect(function()

	_G.Disabled =
		not _G.Disabled

	ToggleAnimation(
		HitBoxToggle,
		HitBoxKnob,
		_G.Disabled
	)

	UpdateAll()

end)

--==================================================
-- ESP BUTTON
--==================================================

ESPToggle.MouseButton1Click:Connect(function()

	_G.ESP =
		not _G.ESP

	ToggleAnimation(
		ESPToggle,
		ESPKnob,
		_G.ESP
	)

	UpdateAll()

end)

--==================================================
-- RAINBOW UPDATE
--==================================================

RunService.RenderStepped:Connect(function()

	if not _G.Disabled
	and not _G.ESP then
		return
	end

	local color =
		GetColor()

	for _,player in ipairs(
		Players:GetPlayers()
	) do

		if player ~= LocalPlayer
		and IsEnemy(player)
		and player.Character then

			local character =
				player.Character

			local hrp =
				character:FindFirstChild(
					"HumanoidRootPart"
				)

			if _G.Disabled and hrp then

				hrp.Size =
					Vector3.new(
						_G.HeadSize,
						_G.HeadSize,
						_G.HeadSize
					)

				hrp.Transparency = 0.7
				hrp.Material = "Neon"
				hrp.CanCollide = false
				hrp.Color = color

			end

			local esp =
				character:FindFirstChild(
					"QuocAnhESP"
				)

			if esp then

				esp.FillColor = color
				esp.OutlineColor = color

			end

		end

	end

	-- NPC
	for _,object in ipairs(
		workspace:GetDescendants()
	) do

		if object:IsA("Model")
		and not Players:GetPlayerFromCharacter(object) then

			local humanoid =
				object:FindFirstChildOfClass(
					"Humanoid"
				)

			local hrp =
				object:FindFirstChild(
					"HumanoidRootPart"
				)

			if humanoid and hrp then

				if _G.Disabled then

					hrp.Size =
						Vector3.new(
							_G.HeadSize,
							_G.HeadSize,
							_G.HeadSize
						)

					hrp.Transparency = 0.7
					hrp.Material = "Neon"
					hrp.CanCollide = false
					hrp.Color = color

				end

				local esp =
					object:FindFirstChild(
						"QuocAnhESP"
					)

				if esp then

					esp.FillColor = color
					esp.OutlineColor = color

				end

			end

		end

	end

end)

--==================================================
-- OPEN / CLOSE MENU
--==================================================

local MenuOpen = false

OpenButton.MouseButton1Click:Connect(function()

	MenuOpen =
		not MenuOpen

	if MenuOpen then

		Main.Visible = true
		Main.Size =
			UDim2.fromOffset(260,220)

		TweenService:Create(
			Main,
			TweenInfo.new(
				0.3,
				Enum.EasingStyle.Back,
				Enum.EasingDirection.Out
			),
			{
				Size =
					ColorOpen
					and UDim2.fromOffset(285,265)
					or UDim2.fromOffset(285,245)
			}
		):Play()

		TweenService:Create(
			OpenButton,
			TweenInfo.new(0.2),
			{
				Rotation = 90
			}
		):Play()

	else

		TweenService:Create(
			Main,
			TweenInfo.new(
				0.2,
				Enum.EasingStyle.Quad,
				Enum.EasingDirection.In
			),
			{
				Size =
					UDim2.fromOffset(260,220)
			}
		):Play()

		TweenService:Create(
			OpenButton,
			TweenInfo.new(0.2),
			{
				Rotation = 0
			}
		):Play()

		task.wait(0.2)

		Main.Visible = false

	end

end)

--==================================================
-- START
--==================================================

ToggleAnimation(
	HitBoxToggle,
	HitBoxKnob,
	_G.Disabled
)

ToggleAnimation(
	ESPToggle,
	ESPKnob,
	_G.ESP
)

UpdateAll()
