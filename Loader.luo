Title.TextColor3 = Color3.fromRGB(255,210,45)
Title.TextSize = 19
Title.Font = Enum.Font.GothamBold
Title.Parent = Main

local function Drag(object,handle)

    local dragging = false
    local dragStart
    local startPos

    handle.InputBegan:Connect(function(input)

        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

            dragging = true
            dragStart = input.Position
            startPos = object.Position

            input.Changed:Connect(function()

                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end

            end)

        end

    end)

    UserInputService.InputChanged:Connect(function(input)

        if not dragging then
            return
        end

        if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then

            local delta = input.Position - dragStart

            object.Position = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )

        end

    end)

end

Drag(Main,Title)
Drag(OpenButton,OpenButton)

local function CreateToggle(y,text)

    local holder = Instance.new("Frame")
    holder.Size = UDim2.new(1,-30,0,38)
    holder.Position = UDim2.fromOffset(15,y)
    holder.BackgroundTransparency = 1
    holder.Parent = Main

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1,-70,1,0)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = Color3.new(1,1,1)
    label.TextSize = 14
    label.Font = Enum.Font.GothamBold
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = holder

    local button = Instance.new("TextButton")
    button.Size = UDim2.fromOffset(52,28)
    button.Position = UDim2.new(1,-52,0.5,-14)
    button.BackgroundColor3 = Color3.fromRGB(60,60,60)
    button.BorderSizePixel = 0
    button.Text = ""
    button.AutoButtonColor = false
    button.Parent = holder

    local bc = Instance.new("UICorner")
    bc.CornerRadius = UDim.new(1,0)
    bc.Parent = button

    local knob = Instance.new("Frame")
    knob.Size = UDim2.fromOffset(22,22)
    knob.Position = UDim2.fromOffset(3,3)
    knob.BackgroundColor3 = Color3.fromRGB(245,245,245)
    knob.BorderSizePixel = 0
    knob.Parent = button

    local kc = Instance.new("UICorner")
    kc.CornerRadius = UDim.new(1,0)
    kc.Parent = knob

    return button,knob
end

local HitToggle,HitKnob =
    CreateToggle(47,"HitBox")

local ESPToggle,ESPKnob =
    CreateToggle(85,"ESP")
--========================================================
-- 👑 QUOC ANH HITBOX - PART 2/5
-- TOGGLE + SIZE 1-50
--========================================================

local function ToggleAnimation(button,knob,state)

    TweenService:Create(
        button,
        TweenInfo.new(.22,Enum.EasingStyle.Quad),
        {
            BackgroundColor3 =
                state
                and Color3.fromRGB(255,195,35)
                or Color3.fromRGB(60,60,60)
        }
    ):Play()

    TweenService:Create(
        knob,
        TweenInfo.new(.25,Enum.EasingStyle.Back),
        {
            Position =
                state
                and UDim2.new(1,-25,0,3)
                or UDim2.fromOffset(3,3)
        }
    ):Play()

end

local SizeLabel = Instance.new("TextLabel")
SizeLabel.Size = UDim2.new(1,-30,0,25)
SizeLabel.Position = UDim2.fromOffset(15,123)
SizeLabel.BackgroundTransparency = 1
SizeLabel.Text = "HitBox Size     10"
SizeLabel.TextColor3 = Color3.new(1,1,1)
SizeLabel.TextSize = 14
SizeLabel.Font = Enum.Font.GothamBold
SizeLabel.TextXAlignment = Enum.TextXAlignment.Left
SizeLabel.Parent = Main

local Slider = Instance.new("TextButton")
Slider.Size = UDim2.new(1,-30,0,8)
Slider.Position = UDim2.fromOffset(15,151)
Slider.BackgroundColor3 = Color3.fromRGB(55,55,55)
Slider.BorderSizePixel = 0
Slider.Text = ""
Slider.AutoButtonColor = false
Slider.Parent = Main

local SliderCorner = Instance.new("UICorner")
SliderCorner.CornerRadius = UDim.new(1,0)
SliderCorner.Parent = Slider

local Fill = Instance.new("Frame")
Fill.Size = UDim2.new(
    (Settings.HitBoxSize-1)/49,
    0,1,0
)
Fill.BackgroundColor3 = Settings.HitBoxColor
Fill.BorderSizePixel = 0
Fill.Parent = Slider

local FillCorner = Instance.new("UICorner")
FillCorner.CornerRadius = UDim.new(1,0)
FillCorner.Parent = Fill

local Sliding = false

local function SetSize(x)

    local percent = math.clamp(
        (x-Slider.AbsolutePosition.X)
        /Slider.AbsoluteSize.X,
        0,1
    )

    Settings.HitBoxSize =
        math.floor(1+percent*49)

    Fill.Size =
        UDim2.new(percent,0,1,0)

    SizeLabel.Text =
        "HitBox Size     "
        ..Settings.HitBoxSize

end

Slider.InputBegan:Connect(function(input)

    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then

        Sliding = true
        SetSize(input.Position.X)

    end

end)

UserInputService.InputChanged:Connect(function(input)

    if not Sliding then
        return
    end

    if input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch then

        SetSize(input.Position.X)

    end

end)

UserInputService.InputEnded:Connect(function(input)

    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then

        Sliding = false

    end

end)

HitToggle.MouseButton1Click:Connect(function()

    Settings.HitBoxEnabled =
        not Settings.HitBoxEnabled

    ToggleAnimation(
        HitToggle,
        HitKnob,
        Settings.HitBoxEnabled
    )

end)

ESPToggle.MouseButton1Click:Connect(function()

    Settings.ESPEnabled =
        not Settings.ESPEnabled

    ToggleAnimation(
        ESPToggle,
        ESPKnob,
        Settings.ESPEnabled
    )

end)
