local function animateToggle(button,knob,enabled)
    TweenService:Create(
        button,
        TweenInfo.new(0.22,Enum.EasingStyle.Quad),
        {
            BackgroundColor3 = enabled
            and Color3.fromRGB(255,195,35)
            or Color3.fromRGB(65,65,65)
        }
    ):Play()

    TweenService:Create(
        knob,
        TweenInfo.new(0.25,Enum.EasingStyle.Back),
        {
            Position = enabled
            and UDim2.new(1,-25,0,3)
            or UDim2.fromOffset(3,3)
        }
    ):Play()
end

