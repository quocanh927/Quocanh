-- MENU DRAG
--==================================================

local MenuDragging = false
local MenuStart
local MenuStartPos
local MenuDragInput

Top.InputBegan:Connect(function(Input)
    if Input.UserInputType == Enum.UserInputType.MouseButton1
    or Input.UserInputType == Enum.UserInputType.Touch then

        MenuDragging = true
        MenuStart = Input.Position
        MenuStartPos = Main.Position
        MenuDragInput = Input
    end
end)

Top.InputChanged:Connect(function(Input)
    if Input.UserInputType == Enum.UserInputType.MouseMovement
    or Input.UserInputType == Enum.UserInputType.Touch then
        MenuDragInput = Input
    end
end)

UIS.InputChanged:Connect(function(Input)
    if not MenuDragging then
        return
    end

    if Input ~= MenuDragInput then
        return
    end

    local Delta = Input.Position - MenuStart

    Main.Position = UDim2.new(
        MenuStartPos.X.Scale,
        MenuStartPos.X.Offset + Delta.X,
        MenuStartPos.Y.Scale,
        MenuStartPos.Y.Offset + Delta.Y
    )
end)

UIS.InputEnded:Connect(function(Input)
    if Input.UserInputType == Enum.UserInputType.MouseButton1
    or Input.UserInputType == Enum.UserInputType.Touch then
        MenuDragging = false
    end
end)

