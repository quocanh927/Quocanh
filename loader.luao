local CurrentCategory = "Home"
local CurrentSearch = ""

local CategoryButtons = {}
local Cards = {}

local function ClearScripts()
    for _,v in ipairs(ScriptScroll:GetChildren()) do
        if not v:IsA("UIListLayout") and not v:IsA("UIPadding") then
            v:Destroy()
        end
    end
    Cards = {}
end

local function MakeSidebarButton(name,icon)

    local Button = Instance.new("TextButton")
    Button.Size = UDim2.new(1,0,0,46)
    Button.BackgroundColor3 = PANEL2
    Button.BackgroundTransparency = .55
    Button.BorderSizePixel = 0
    Button.Text = ""
    Button.AutoButtonColor = false
    Button.ZIndex = 25
    Button.Parent = Sidebar

    local C = Instance.new("UICorner")
    C.CornerRadius = UDim.new(0,11)
    C.Parent = Button

    local Circle = Instance.new("Frame")
    Circle.Size = UDim2.fromOffset(32,32)
    Circle.Position = UDim2.new(0,7,.5,0)
    Circle.AnchorPoint = Vector2.new(0,.5)
    Circle.BackgroundColor3 = BLUE
    Circle.BackgroundTransparency = .2
    Circle.BorderSizePixel = 0
    Circle.ZIndex = 26
    Circle.Parent = Button

    local CC = Instance.new("UICorner")
    CC.CornerRadius = UDim.new(1,0)
    CC.Parent = Circle

    local I = Instance.new("TextLabel")
    I.Size = UDim2.fromScale(1,1)
    I.BackgroundTransparency = 1
    I.Text = icon
    I.TextSize = 15
    I.ZIndex = 27
    I.Parent = Circle

    local T = Instance.new("TextLabel")
    T.Size = UDim2.new(1,-50,1,0)
    T.Position = UDim2.fromOffset(47,0)
    T.BackgroundTransparency = 1
    T.Text = name
    T.TextColor3 = GRAY
    T.TextSize = 11
    T.Font = Enum.Font.GothamMedium
    T.TextXAlignment = Enum.TextXAlignment.Left
    T.ZIndex = 26
    T.Parent = Button

    CategoryButtons[name] = Button

    Button.MouseEnter:Connect(function()
        if CurrentCategory ~= name then
            TweenService:Create(Button,TweenInfo.new(.12),{
                BackgroundTransparency=.25
            }):Play()
        end
    end)

    Button.MouseLeave:Connect(function()
        if CurrentCategory ~= name then
            TweenService:Create(Button,TweenInfo.new(.12),{
                BackgroundTransparency=.55
            }):Play()
        end
    end)

    return Button
end

local function SetActive(name)

    for n,b in pairs(CategoryButtons) do
        local circle = b:FindFirstChildOfClass("Frame")
        local text = b:FindFirstChildWhichIsA("TextLabel")

        if n == name then
            b.BackgroundColor3 = BLUE
            b.BackgroundTransparency = .15

            if circle then
                circle.BackgroundColor3 = Color3.fromRGB(255,255,255)
                circle.BackgroundTransparency = .08
            end

            if text then
                text.TextColor3 = WHITE
            end
        else
            b.BackgroundColor3 = PANEL2
            b.BackgroundTransparency = .55

            if circle then
                circle.BackgroundColor3 = BLUE
                circle.BackgroundTransparency = .2
            end

            if text then
                text.TextColor3 = GRAY
            end
        end
    end
end

local Home = MakeSidebarButton("Home","⌂")
local Egg = MakeSidebarButton("Steal a Egg","🥚")
local Blox = MakeSidebarButton("Blox Fruit","🍎")
local Blade = MakeSidebarButton("Blade Ball","⚔")

local function MakeScriptCard(data)

    local Button = Instance.new("TextButton")
    Button.Size = UDim2.new(1,0,0,48)
    Button.BackgroundColor3 = PANEL
    Button.BackgroundTransparency = .08
    Button.BorderSizePixel = 0
    Button.Text = ""
    Button.AutoButtonColor = false
    Button.ZIndex = 27
    Button.Parent = ScriptScroll

    local C = Instance.new("UICorner")
    C.CornerRadius = UDim.new(0,12)
    C.Parent = Button

    local S = Instance.new("UIStroke")
    S.Color = Color3.fromRGB(75,80,105)
    S.Transparency = .55
    S.Thickness = 1
    S.Parent = Button

    local Icon = Instance.new("Frame")
    Icon.Size = UDim2.fromOffset(30,30)
    Icon.Position = UDim2.new(0,8,.5,0)
    Icon.AnchorPoint = Vector2.new(0,.5)
    Icon.BackgroundColor3 = BLUE
    Icon.BackgroundTransparency = .2
    Icon.BorderSizePixel = 0
    Icon.ZIndex = 28
    Icon.Parent = Button

    local IC = Instance.new("UICorner")
    IC.CornerRadius = UDim.new(1,0)
    IC.Parent = Icon

    local IT = Instance.new("TextLabel")
    IT.Size = UDim2.fromScale(1,1)
    IT.BackgroundTransparency = 1
    IT.Text = "▶"
    IT.TextColor3 = WHITE
    IT.TextSize = 11
    IT.Font = Enum.Font.GothamBold
    IT.ZIndex = 29
    IT.Parent = Icon

    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.new(1,-55,1,0)
    Label.Position = UDim2.fromOffset(48,0)
    Label.BackgroundTransparency = 1
    Label.Text = data[1]
    Label.TextColor3 = WHITE
    Label.TextSize = 12
    Label.Font = Enum.Font.GothamMedium
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.ZIndex = 28
    Label.Parent = Button

    Button.MouseEnter:Connect(function()
        TweenService:Create(Button,TweenInfo.new(.12),{
            BackgroundColor3 = Color3.fromRGB(42,44,57),
            BackgroundTransparency = 0
        }):Play()
        TweenService:Create(Icon,TweenInfo.new(.12),{
            Size = UDim2.fromOffset(34,34)
        }):Play()
    end)

    Button.MouseLeave:Connect(function()
        TweenService:Create(Button,TweenInfo.new(.12),{
            BackgroundColor3 = PANEL,
            BackgroundTransparency = .08
        }):Play()
        TweenService:Create(Icon,TweenInfo.new(.12),{
            Size = UDim2.fromOffset(30,30)
        }):Play()
    end)

    Button.Activated:Connect(function()

        local old = Label.Text
        Label.Text = "⏳  Loading..."

        task.spawn(function()

            local ok,err = pcall(function()
                local fn = loadstring(data[2])
                if not fn then
                    error("Không thể load script")
                end
                fn()
            end)

            if ok then
                Label.Text = "✓  "..old
            else
                Label.Text = "✕  "..old
                warn("[QuocAnhMenu]",err)
            end

            task.wait(1)

            if Label and Label.Parent then
                Label.Text = old
            end
        end)
    end)

    table.insert(Cards,{
        Button=Button,
        Name=data[1]
    })
end

local function ShowHome()

    ClearScripts()

    local Box = Instance.new("Frame")
    Box.Size = UDim2.new(1,0,0,100)
    Box.BackgroundColor3 = PANEL
    Box.BackgroundTransparency = .08
    Box.BorderSizePixel = 0
    Box.ZIndex = 26
    Box.Parent = ScriptScroll

    local C = Instance.new("UICorner")
    C.CornerRadius = UDim.new(0,14)
    C.Parent = Box

    local T = Instance.new("TextLabel")
    T.Size = UDim2.new(1,-20,0,35)
    T.Position = UDim2.fromOffset(12,10)
    T.BackgroundTransparency = 1
    T.Text = "👑  Welcome to QuocAnhMenu"
    T.TextColor3 = WHITE
    T.TextSize = 16
    T.Font = Enum.Font.GothamBold
    T.TextXAlignment = Enum.TextXAlignment.Left
    T.ZIndex = 27
    T.Parent = Box

    local D = Instance.new("TextLabel")
    D.Size = UDim2.new(1,-20,0,40)
    D.Position = UDim2.fromOffset(12,48)
    D.BackgroundTransparency = 1
    D.Text = "Chọn game ở bên trái để xem toàn bộ script."
    D.TextColor3 = GRAY
    D.TextSize = 11
    D.Font = Enum.Font.Gotham
    D.TextXAlignment = Enum.TextXAlignment.Left
    D.ZIndex = 27
    D.Parent = Box
end

local function ShowCategory(name)

    CurrentCategory = name
    CurrentSearch = ""
    Search.Text = ""

    SetActive(name)

    if name == "Home" then
        ShowHome()
        return
    end

    ClearScripts()

    local list = Scripts[name]

    if not list then return end

    for _,data in ipairs(list) do
        MakeScriptCard(data)
    end
end

Search:GetPropertyChangedSignal("Text"):Connect(function()

    local q = string.lower(Search.Text)

    for _,card in ipairs(Cards) do

        if q == "" then
            card.Button.Visible = true
        else
            card.Button.Visible =
                string.find(string.lower(card.Name),q,1,true) ~= nil
        end

    end
end)

Home.Activated:Connect(function()
    ShowCategory("Home")
end)

Egg.Activated:Connect(function()
    ShowCategory("Steal a Egg")
end)

Blox.Activated:Connect(function()
    ShowCategory("Blox Fruit")
end)

Blade.Activated:Connect(function()
    ShowCategory("Blade Ball")
end)

ShowCategory("Home")
