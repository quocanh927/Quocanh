--==================================================
-- DRAG FUNCTION
--==================================================

local function DragObject(object,handle)

    local dragging = false
    local start
    local startPos

    handle.InputBegan:Connect(function(input)

        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

            dragging = true
            start = input.Position
            startPos = object.Position

            input.Changed:Connect(function()

                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end

            end)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)

        if not dragging then return end

        if input.UserInputType ~= Enum.UserInputType.MouseMovement
        and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end

        local delta = input.Position-start

        object.Position = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset+delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset+delta.Y
        )
    end)
end

DragObject(Main,Header)
DragObject(Crown,Crown)

--==================================================
-- OPEN / CLOSE
--==================================================

local function OpenMenu()

    if Busy or Open then return end

    Busy = true
    Open = true

    Main.Visible = true
    Main.Size = UDim2.fromOffset(520,330)

    TweenService:Create(
        Main,
        TweenInfo.new(.25,Enum.EasingStyle.Quint,Enum.EasingDirection.Out),
        {
            Size=UDim2.fromOffset(570,365)
        }
    ):Play()

    TweenService:Create(
        Crown,
        TweenInfo.new(.18),
        {
            Rotation=-8
        }
    ):Play()

    task.delay(.27,function()
        Busy=false
    end)
end

local function CloseMenu()

    if Busy or not Open then return end

    Busy=true
    Open=false

    TweenService:Create(
        Main,
        TweenInfo.new(.2,Enum.EasingStyle.Quint,Enum.EasingDirection.In),
        {
            Size=UDim2.fromOffset(520,330)
        }
    ):Play()

    TweenService:Create(
        Crown,
        TweenInfo.new(.18),
        {
            Rotation=8
        }
    ):Play()

    task.delay(.21,function()
        Main.Visible=false
        Busy=false
    end)
end

Crown.Activated:Connect(function()

    if Open then
        CloseMenu()
    else
        OpenMenu()
    end

end)

